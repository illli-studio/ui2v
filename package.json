{
  "name": "@ui2v/workspace",
  "version": "2.0.0",
  "description": "UI2V workspace — HyperFrames motion registry CLI (replaces the old @ui2v/cli JSON toolchain)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter ui2v build",
    "dev": "bun run --filter ui2v dev",
    "test": "bun run --filter ui2v test",
    "ui2v": "node packages/ui2v/bin/ui2v.js",
    "cli": "node packages/ui2v/bin/ui2v.js"
  },
  "keywords": [
    "ui2v",
    "hyperframes",
    "motion",
    "registry",
    "cli"
  ],
  "author": "ui2v",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^25.5.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  }
}
